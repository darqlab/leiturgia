# =============================================================================
# Template for /etc/sudoers.d/leiturgia-update  (Cantor host artifact)
#
# This is NOT installed automatically — Castellan/Dennis copies this file to
# /etc/sudoers.d/leiturgia-update on the host (Cantor only) as part of
# provisioning, then:
#
#   sudo install -m 0440 leiturgia-update.sudoers /etc/sudoers.d/leiturgia-update
#   sudo visudo -c
#
# Mode MUST be 0440, and the file MUST be validated with `visudo -c` before
# (and after) installing — sudoers syntax errors can lock out sudo entirely.
#
# Why `leiturgia`: the rule targets the `leiturgia` service's `User=`
# (see packaging/leiturgia.service). OQ-1's target end state — a dedicated,
# unprivileged `leiturgia` system account, created by packaging/debian/postinst
# — has landed; `pi` (and, transiently on Cantor, `dennis`) were interim
# values used before this migration (issue #97).
#
# This is the security hinge of the whole feature: it grants the web user
# (running as `leiturgia`) passwordless root privilege to start EXACTLY ONE
# systemd unit — leiturgia-update.service — and nothing else. Do not widen
# this rule.
# =============================================================================

leiturgia ALL=(root) NOPASSWD: /usr/bin/systemctl start leiturgia-update.service
